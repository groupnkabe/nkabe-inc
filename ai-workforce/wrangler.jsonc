{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nkabe-ai-workforce",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHIEF_OF_STAFF",
        "class_name": "ChiefOfStaffAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChiefOfStaffAgent"]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
